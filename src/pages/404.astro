---
import Base from '../layouts/Base.astro';
---
<Base lang="es" routeKey="home" title="404" ticker={false}>
  <section>
    <div class="wrap" style="text-align:center; padding: 80px 0;">
      <span class="kicker">error 404</span>
      <h1 style="font-size:clamp(32px,6vw,64px)">Esta página no cabe en 1492 tokens.</h1>
      <p style="color:var(--ink-soft); margin:18px 0 30px">O no existe, o se ha movido.</p>
      <a href="/" class="btn btn-solid">Volver al inicio</a>
    </div>
  </section>
</Base>
