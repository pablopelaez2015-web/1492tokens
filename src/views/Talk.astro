---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { useTranslations, useRoutes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
const { lang, talk } = Astro.props as { lang: Lang; talk: CollectionEntry<'talks'> };
const t = useTranslations(lang);
const r = useRoutes(lang);
const { Content } = await render(talk);
const d = talk.data;
---
<Base lang={lang} routeKey="talks" title={d.title} description={`${d.speaker} · ${d.city}`}>
  <section>
    <div class="wrap wrap-narrow">
      <p class="back"><a href={r('talks')}>{t('talks.back')}</a></p>
      <span class="kicker">{d.city} · {d.date.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { day:'numeric', month:'long', year:'numeric' })} · {d.duration}</span>
      <h1 class="title">{d.title}</h1>
      <p class="speaker">{d.speakerLinkedIn ? <a href={d.speakerLinkedIn} target="_blank" rel="noopener">{d.speaker}</a> : d.speaker}</p>
      <div class="video"><YouTube id={d.youtubeId} title={d.title} /></div>
      <div class="prose"><Content /></div>
      {d.tags.length > 0 && <div class="tags">{d.tags.map(x => <span class="pill">{x}</span>)}</div>}
    </div>
  </section>
</Base>
<style>
  .back{ margin-bottom:24px; font-size:14px; color: var(--ink-soft); }
  .title{ font-size: clamp(28px,4vw,44px); line-height:1.08; margin-top:6px; }
  .speaker{ margin-top:12px; font-size:16px; color: var(--ink-soft); }
  .speaker a{ color: var(--mint); }
  .video{ margin:32px 0; }
  .tags{ display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
</style>
