---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Base lang={lang} routeKey="about" title={t('about.title')}>
  <section>
    <div class="wrap wrap-narrow">
      <div class="section-head">
        <span class="kicker">{t('about.title')}</span>
        <h1>{t('about.h1')}</h1>
      </div>
      <div class="prose">
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
      </div>
      <div class="card card-grad contact">
        <h2 class="h">{t('about.contact.h')}</h2>
        <p class="p">{t('about.contact.p')}</p>
        <p class="p"><a class="mail" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
        {site.founderLinkedIn && <p class="p"><a class="mail" href={site.founderLinkedIn} target="_blank" rel="noopener">LinkedIn — {site.founder}</a></p>}
      </div>
    </div>
  </section>
</Base>
<style>
  .contact{ margin-top:36px; }
  .h{ font-size:20px; margin-bottom:6px; }
  .p{ color: var(--ink-soft); line-height:1.6; font-size:15px; margin-top:8px; }
  .mail{ color: var(--mint); text-decoration: underline; text-underline-offset:3px; }
</style>
