---
// Formulario de newsletter conectado a Brevo.
// Configuración: pon en src/config.ts → site.newsletterAction la URL "action" del
// formulario de Brevo (https://xxxx.sibforms.com/serve/...). Ver README → Newsletter.
import { useTranslations, useRoutes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const r = useRoutes(lang);
const action = site.newsletterAction ? `${site.newsletterAction}${site.newsletterAction.includes('?') ? '&' : '?'}isAjax=1` : '';
---
<section class="news-section">
  <div class="wrap">
    <div class="news-panel">
      <h2>{t('news.h2')}</h2>
      <p>{t('news.p')}</p>

      {action ? (
        <div class="sib-form">
          <div id="sib-form-container" class="sib-form-container">
            <div id="error-message" class="sib-form-message-panel sib-form-message-panel--error">
              <div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">{t('news.error')}</span></div>
            </div>
            <div id="success-message" class="sib-form-message-panel sib-form-message-panel--success">
              <div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">{t('news.success')}</span></div>
            </div>
            <div id="sib-container" class="sib-container--large">
              <form id="sib-form" method="POST" action={action} data-type="subscription">
                <div class="news-form">
                  <input class="input" type="email" id="EMAIL" name="EMAIL" autocomplete="email" placeholder={t('news.placeholder')} data-required="true" required />
                  <button class="sib-form-block__button sib-form-block__button-with-loader" type="submit" form="sib-form">
                    <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512" width="16" height="16" aria-hidden="true"><path d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z"/></svg>
                    {t('news.btn')}
                  </button>
                </div>
                <input type="text" name="email_address_check" value="" class="input--hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <input type="hidden" name="locale" value={lang === 'es' ? 'es' : 'en'} />
              </form>
            </div>
          </div>
        </div>
      ) : (
        <p class="soon">{t('news.soon')} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
      )}

      <p class="privacy"><a href={r('privacy')}>{t('news.privacy')}</a>
        {site.newsletterUnsubscribeUrl && <span> · {t('news.unsub')} <a href={site.newsletterUnsubscribeUrl} target="_blank" rel="noopener">{t('news.unsub.link')}</a></span>}
      </p>
    </div>
  </div>
</section>

{action && (
  <script is:inline>
    window.REQUIRED_CODE_ERROR_MESSAGE = 'Elige un código de país';
    window.LOCALE = 'es';
    window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = 'La información que has facilitado no es válida. Comprueba el formato del campo e inténtalo de nuevo.';
    window.REQUIRED_ERROR_MESSAGE = 'Este campo es obligatorio.';
    window.GENERIC_INVALID_MESSAGE = 'La información que has facilitado no es válida. Comprueba el formato del campo e inténtalo de nuevo.';
    window.translation = { common: { selectedList: '{quantity} lista seleccionada', selectedLists: '{quantity} listas seleccionadas', selectedOption: '{quantity} seleccionado', selectedOptions: '{quantity} seleccionados' } };
    var AUTOHIDE = Boolean(0);
  </script>
  <script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
)}

<style>
  .news-section{ padding-top:0; }
  .news-panel{ background: linear-gradient(120deg, var(--violet), var(--coral)); border-radius:28px; padding: 44px 24px; text-align:center; }
  @media (min-width:760px){ .news-panel{ padding:56px 48px; } }
  .news-panel h2{ color:#0A0A12; font-size: clamp(26px,3.6vw,40px); }
  .news-panel p{ color: rgba(10,10,18,.75); margin-top:12px; font-size:15.5px; }
  .news-form{ margin-top:26px; display:flex; gap:10px; justify-content:center; max-width:460px; margin-left:auto; margin-right:auto; flex-wrap:wrap; }
  .news-form .input{ flex:1; min-width:200px; padding:14px 18px; border-radius:100px; border:none; font-family:'Inter',sans-serif; font-size:14.5px; }
  .news-form button{ background: #0A0A12; color:#fff; border:none; padding:14px 26px; border-radius:100px; font-weight:600; font-size:14.5px; cursor:pointer; transition: transform .15s; display:inline-flex; align-items:center; gap:8px; font-family:'Inter',sans-serif; }
  .news-form button:hover{ transform: translateY(-2px); }
  .news-form button .icon{ display:none; fill:#fff; }
  .news-form button.sib-form-block__button-with-loader .icon{ display:none; }
  .input--hidden{ position:absolute; left:-9999px; opacity:0; height:0; width:0; }
  .sib-form-message-panel{ display:none; margin:18px auto 0; max-width:460px; padding:12px 18px; border-radius:14px; font-size:14px; font-weight:500; text-align:left; }
  .sib-form-message-panel--active{ display:block !important; }
  .sib-form-message-panel--error{ background: rgba(10,10,18,.85); color:#fff; }
  .sib-form-message-panel--success{ background: #0A0A12; color: var(--mint); }
  :global(.sib-form-block__button--hidden){ display:none; }
  .soon{ margin-top:22px; }
  .soon a{ color:#0A0A12; text-decoration: underline; font-weight:600; }
  .privacy{ margin-top:14px; font-size:12px; }
  .privacy a{ color: rgba(10,10,18,.6); text-decoration: underline; }
</style>
