---
import { useTranslations, useRoutes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../config';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const r = useRoutes(lang);
---
<section class="news-section">
  <div class="wrap">
    <div class="news-panel">
      <h2>{t('news.h2')}</h2>
      <p>{t('news.p')}</p>
      <form class="news-form" action={site.newsletterAction || '#'} method="post" onsubmit={site.newsletterAction ? undefined : 'return false;'}>
        <input type="email" name="email" placeholder={t('news.placeholder')} required />
        <button type="submit">{t('news.btn')}</button>
      </form>
      <p class="privacy"><a href={r('privacy')}>{t('news.privacy')}</a></p>
    </div>
  </div>
</section>
<style>
  .news-section{ padding-top:0; }
  .news-panel{ background: linear-gradient(120deg, var(--violet), var(--coral)); border-radius:28px; padding: 44px 24px; text-align:center; }
  @media (min-width:760px){ .news-panel{ padding:56px 48px; } }
  .news-panel h2{ color:#0A0A12; font-size: clamp(26px,3.6vw,40px); }
  .news-panel p{ color: rgba(10,10,18,.75); margin-top:12px; font-size:15.5px; }
  .news-form{ margin-top:26px; display:flex; gap:10px; justify-content:center; max-width:460px; margin-left:auto; margin-right:auto; flex-wrap:wrap; }
  .news-form input{ flex:1; min-width:200px; padding:14px 18px; border-radius:100px; border:none; font-family:'Inter',sans-serif; font-size:14.5px; }
  .news-form button{ background: #0A0A12; color:#fff; border:none; padding:14px 26px; border-radius:100px; font-weight:600; font-size:14.5px; cursor:pointer; transition: transform .15s; }
  .news-form button:hover{ transform: translateY(-2px); }
  .privacy{ margin-top:14px; font-size:12px; }
  .privacy a{ color: rgba(10,10,18,.6); text-decoration: underline; }
</style>
